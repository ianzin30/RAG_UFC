# Core LLM settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_INTENT_MODEL=llama-3.1-8b-instant

# Telegram bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Scraping / Firecrawl
FIRECRAWL_LOCAL_URL=http://localhost:3002
SCRAPING_API_URL=http://localhost:3002
SCRAPING_API_KEY=your_firecrawl_cloud_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_cloud_api_key_here

# Note:
# Google OAuth credentials are not read from .env.
# Keep them in google-oauth-credentials.json at the project root.
