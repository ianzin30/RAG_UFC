# vLLM over a local SSH tunnel, or loopback when the app runs on the same VM.
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
SCRAPING_API_KEY=
FIRECRAWL_API_KEY=
SCRAPING_API_URL=

# Optional: OAuth credentials path. Streamlit uses a Web client;
# Telegram also accepts the existing desktop flow.
GOOGLE_OAUTH_CREDENTIALS_FILE=./config/google-oauth-credentials.json
