UFC_API_KEY=your_ufc_api_key_here
UFC_MODEL_NAME=llama3.1:8b
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Optional: override the UFC Ollama-compatible endpoint
UFC_API_URL=http://ollama.atlab.ufc.br:8080/ollama/api/generate

# Optional: used by the scraping flow when you are not running Firecrawl locally
SCRAPING_API_KEY=your_firecrawl_api_key_here

# Optional alias accepted by the scraping service
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Optional: local Firecrawl endpoint
FIRECRAWL_LOCAL_URL=http://localhost:3002

# Optional alias accepted by the scraping service
SCRAPING_API_URL=http://localhost:3002

# Optional: used only by the Telegram bot flow
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: override the default Google OAuth desktop credentials path
GOOGLE_OAUTH_CREDENTIALS_FILE=./config/google-oauth-credentials.json
